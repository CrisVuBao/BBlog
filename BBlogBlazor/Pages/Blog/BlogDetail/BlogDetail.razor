@page "/blog-detail/{PostId}"
@using BBlogBlazor.Component
@using BBlogBlazor.Static

@if (PostDetail == null)
{
    <LoadingBar></LoadingBar>
}
else
{
    <!--------------------------------------
    HEADER
    --------------------------------------->
    <div class="blog-detail-layout">
        <div class="blog-detail-layout-inside container">
            <div class="jumbotron jumbotron-fluid mb-3 pl-0 pt-0 pb-0 bg-white position-relative">
                <div class="h-100 tofront">
                    <div class="row justify-content-between">
                        <div class="col-md-6 pt-6 pb-6 pr-6 align-self-center">
                            <h1 class="secondfont mb-3" style="">@PostDetail.Title</h1>
                            <p class="mb-3 h6">
                                @PostDetail.BriefContent
                            </p>
                            <div class="d-flex align-items-center">
                                <small class="ml-2">
                                    Jane Seymour <span class="text-muted d-block">A few hours ago &middot; 5 min. read</span>
                                </small>
                            </div>
                        </div>
                        <div class="col-md-6 pr-0 w-50">
                            <img class="img-fluid" src="@($"{APIEndpoints.ServerBaseUrl}/{PostDetail.PicturePostUrl}")" style="border-radius:15px;">
                        </div>
                    </div>
                </div>
            </div>
            <!-- End Header -->
            <!--------------------------------------
            MAIN
            --------------------------------------->
            <div class="container pt-4 pb-4">
                <div class="row justify-content-center">
                    <div class="col-md-12 col-lg-10">
                        <article class="content-post">
                            <div @ref="_quillJSReadEditorDiv" class="content-quilljs"></div>
                            <hr />
                            <h1>Phần bình luận</h1>

                        </article>
                    </div>

                    <div class="col-lg-2  ">
                        <div class="sticky-top">
                            <div class="text-muted">
                                Bài viết nổi bật
                            </div>
                            <div class="share d-inline-block">
                                <!-- AddToAny BEGIN -->
                                @foreach(var topPost in GetTopPost) {
                                <div class="mb-3 d-flex align-items-center top-new-layout">
                                    <div class="pl-3">
                                        <h2 class="mb-1 h6 font-weight-bold">
                                                <a class="text-dark text-decoration-none" href="blog-detail/@topPost.PostId">@topPost.Title</a>
                                        </h2>
                                        <small class="text-muted">@topPost.CreateDate</small>
                                    </div>
                                </div>
                                }
                                <!-- AddToAny END -->
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}

